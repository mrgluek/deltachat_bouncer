# Custom display name for the bot (e.g. "Steward Bot", "Consul Bot", etc.)
# If not set, defaults to "Bouncer Bot"
DISPLAY_NAME=Bouncer Bot

# Custom status message for the bot
# If not set, defaults to the standard inactive user tracking description
STATUS_TEXT=I monitor group activity, manage chat/channel catalogs, welcome new members, and search contacts. Send /help for commands.

# Custom avatar/icon path for the bot (absolute or relative to bot.py)
# If not set, defaults to icon.png in the project directory
# AVATAR_PATH=icon.png

# CMPing monitoring interval in seconds (how often to check server connectivity)
# Default is 1800 (30 minutes). Set to 0 to disable monitoring.
# CMPING_MONITOR_INTERVAL=1800

# VirusTotal API Key for URL and file inspection (/virus command)
# Obtain a free API key at https://www.virustotal.com
# VIRUSTOTAL_API_KEY=your_api_key_here


# ipinfo.io token for /ip (optional). /ip works without one; RIPEstat (no key)
# answers prefix and AS lookups. With a token the bot tries it first, then no
# token, then the free Lite API (country + AS only, unlimited requests).
# A paid token (Core and up) adds VPN / proxy / Tor / hosting flags.
# Get one at https://ipinfo.io/signup
# IPINFO_TOKEN=your_token_here

# Resolvers /dns asks by default (comma-separated). Public ones show what the
# internet sees; the system resolver (systemd-resolved on Ubuntu) drops DS
# records, so DNSSEC would look unsigned. Empty = use the system resolver.
# DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Ntfy Bot has its own /newgroup. In groups where it is a member, plain /newgroup
# is left to it. Comma-separated full addresses or local parts (default: ntfydcbot).
# NTFY_BOT_ADDRS=ntfydcbot

# "@Nick text" at the start of a group message is sent again by the bot as a
# reply to Nick's last message, so Nick gets a notification. 0 turns it off.
# MENTION_REPLY=1

# A nick nobody in the group has is looked up with Username Bot (only where it is a
# member, recognized by address) and its short link sent privately to the author.
# Empty USERNAME_LOOKUP_URL turns the lookup off.
# USERNAME_BOT_ADDRS=usernamebot
# USERNAME_LOOKUP_URL=https://deltachat.id
